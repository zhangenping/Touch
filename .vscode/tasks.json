{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: 开发服务器",
      "type": "npm",
      "script": "dev",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "dev: 局域网手机预览",
      "type": "shell",
      "command": "npm run dev -- --host",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "build: 生产构建",
      "type": "npm",
      "script": "build",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "preview: 预览构建结果",
      "type": "npm",
      "script": "preview",
      "dependsOn": ["build: 生产构建"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
