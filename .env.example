# 复制为 .env 后修改

# PostgreSQL（与 docker-compose.yml 中 db 服务默认账号一致）
DATABASE_URL="postgresql://touch:touch_secret@localhost:5432/touch?schema=public"

# 云数据库 / Railway 示例
# DATABASE_URL="postgresql://user:password@host:5432/touch?schema=public"

JWT_SECRET="change-this-to-a-long-random-secret-in-production"
PORT=3001
NODE_ENV=development
